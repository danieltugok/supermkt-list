# Keep non-app files from being downloadable from the website.
<FilesMatch "^(README\.md|CHANGELOG\.md|database\.rules\.json|\.gitignore|\.htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Never expose the git folder if the deploy copies it.
RedirectMatch 404 /\.git

# Always revalidate the app files so browsers and the CDN never serve a stale copy
# (a 304 response keeps this cheap). Images/icons can stay cached.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|app\.js|styles\.css|firebase-config\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
